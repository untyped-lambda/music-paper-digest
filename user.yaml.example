# user.yaml.example — 個人の好みで config.yaml を上書きするための任意ファイル
#
# 使い方:
#   1. このファイルを同じディレクトリに `user.yaml` としてコピーする
#   2. 上書きしたいキーだけコメントを外して値を書く
#   3. コミットして構わない(このファイルには秘密情報を書かないこと。
#      宛先メールアドレスや API キーなどは環境変数 / GitHub Secrets 側で管理する)
#
# 優先順位: 環境変数 > user.yaml > config.yaml
# config.yaml の任意のキーをディープマージで上書きできる(ネストしたキーも可)。
# 存在しないキーだけを部分的に上書きすればよく、config.yaml 全体を書き写す必要はない。

# 件名の先頭に付与する文字列
# subject_prefix: "🎵 My Music Digest"

# 日本語要約付きの「ハイライト」に採用する上位件数 (既定18件)
# highlight_count: 12

# 本文の「その他タイトル一覧」に載せる上限件数。超過分は添付HTMLへ (既定50件)
# others_max_in_body: 30

# 何日分さかのぼって収集するか (既定7日)
# lookback_days: 7

# ネストしたキーもディープマージで上書きできる例:
# sources:
#   arxiv:
#     enabled: false
